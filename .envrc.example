# chat completions or resposes
export CAPX_LLM_WIRE=responses
export OPENAI_BASE_URL=https://api.openai.com/v1
export OPENAI_API_KEY=sk-

export SAM3_SERVICE_URL=http://127.0.0.1:8114
export GRASPNET_SERVICE_URL=http://127.0.0.1:8115
export PYROKI_SERVICE_URL=http://127.0.0.1:8116
export SAM2_SERVICE_URL=http://127.0.0.1:8113
export OWLVIT_SERVICE_URL=http://127.0.0.1:8117
# Molmo (capx/integrations/vision/molmo.py) — a pointing/grounding VLM
# FrankaLiberoApi falls back to when SAM3's text-prompted segmentation
# finds nothing for a query. Served directly via vLLM like the workshop
# reasoning LLM below, no dedicated capx server launcher.
export MOLMO_SERVICE_URL=http://127.0.0.1:8122/v1
export MOLMO_MODEL=allenai/Molmo2-8B

# workshop/backend's prompt-engineering mode (llm_client.py) — a local,
# OpenAI-compatible vLLM server it talks to directly over the LAN. Only this
# backend process ever calls it; never exposed via the Cloudflare Tunnel.
export WORKSHOP_VLLM_BASE_URL=http://127.0.0.1:8000/v1
export WORKSHOP_VLLM_MODEL=default
# export WORKSHOP_VLLM_API_KEY=  # optional; vLLM ignores it by default

# Model name sent to Molmo by sandboxed session containers (read by
# workshop/backend/session_manager.py). The Molmo server address itself is
# MOLMO_UPSTREAM in workshop/docker/.env (perception-proxy-molmo).
export WORKSHOP_VLLM_MOLMO2_MODEL=allenai/Molmo2-8B

# api_servers[] in env_configs YAML no longer carry host/port; the
# *_SERVICE_URL vars above are the single source of truth for where each
# perception/motion server lives. By default, launch.py errors out if a
# server isn't reachable there. Uncomment to instead auto-launch a missing
# server as a local subprocess (only works when its *_SERVICE_URL resolves
# to a local host):
# export CAPX_AUTO_LAUNCH_SERVERS=1