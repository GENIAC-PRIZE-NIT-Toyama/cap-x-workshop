[Unit]
Description=CaP-X Workshop WebUI backend
Documentation=file:///home/ifl_admin/repository/cap-x/workshop/README.md
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
User=ifl_admin
Group=docker
WorkingDirectory=/home/ifl_admin/repository/cap-x
ExecStart=/home/ifl_admin/.local/bin/uv run python -m workshop.backend.main --host 0.0.0.0 --port 8200
Restart=on-failure
RestartSec=5
# session_manager.py shells out to `docker`; being in the docker group (via
# Group= above) is what grants that, not any special capability here.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
