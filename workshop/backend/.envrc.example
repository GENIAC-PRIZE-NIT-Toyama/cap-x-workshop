# Copy to workshop/backend/.envrc and `direnv allow`, or `source` it before
# launching the backend (see workshop/backend/main.py).
#
# These point at the Perception API servers (SAM3 / GraspNet / PyRoKi)
# running on the LAN — see WORKSHOP_ENDPOINT.md. The backend/Session Worker
# processes resolve these the same way the main capx code does
# (capx/serving/launch_servers.py resolve_endpoint(), .envrc.example at repo
# root) — nothing new to implement here, just point the URLs at the right
# host. Perception servers are never exposed through the Cloudflare Tunnel
# (WORKSHOP_WEBUI_SPEC.md section 4).

export SAM3_SERVICE_URL=http://192.168.0.200:8114
export GRASPNET_SERVICE_URL=http://192.168.0.200:8115
export PYROKI_SERVICE_URL=http://192.168.0.200:8116
