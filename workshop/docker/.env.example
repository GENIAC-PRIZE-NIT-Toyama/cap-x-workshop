# Copy to workshop/docker/.env before `docker compose -f docker-compose.tunnel.yml up -d`.
#
# Get this token from the Cloudflare Zero Trust dashboard:
# Networks > Tunnels > (create/select a tunnel) > Install connector > Docker.
# The token already encodes which tunnel this connector belongs to, so no
# config.yml is needed for this Token-based setup (see cloudflared/config.yml.example
# for the alternative, file-based setup if you prefer that instead).
CLOUDFLARE_TUNNEL_TOKEN=
